{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answerable.dev/schemas/v1/statistical-result.schema.json",
  "title": "Statistical result",
  "type": "object",
  "additionalProperties": false,
  "required": ["estimate", "standard_error", "confidence_interval", "effect_size", "p_value", "adjusted_p_value", "power", "minimum_detectable_effect"],
  "properties": {
    "estimate": {"type": "number"},
    "standard_error": {"type": "number", "minimum": 0},
    "confidence_interval": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "effect_size": {"type": "number"},
    "p_value": {"type": "number", "minimum": 0, "maximum": 1},
    "adjusted_p_value": {"type": "number", "minimum": 0, "maximum": 1},
    "power": {"type": "number", "minimum": 0, "maximum": 1},
    "minimum_detectable_effect": {"type": "number", "minimum": 0}
  }
}
