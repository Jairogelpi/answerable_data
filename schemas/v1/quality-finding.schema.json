{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answerable.dev/schemas/v1/quality-finding.schema.json",
  "title": "Quality finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "message", "affected_columns", "hypothesis_only"],
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "severity": {"enum": ["info", "warning", "blocker"]},
    "message": {"type": "string", "minLength": 1},
    "affected_columns": {"type": "array", "items": {"type": "string"}},
    "observed": {"type": ["number", "integer", "string", "null"]},
    "hypothesis_only": {"type": "boolean"}
  }
}
