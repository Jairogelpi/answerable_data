{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answerable.dev/schemas/v1/check-plan.schema.json",
  "title": "Check Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "assessment_id", "checks"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "type": "string", "minLength": 1 },
    "assessment_id": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "check_type",
          "check_version",
          "requirement_id",
          "executor",
          "severity_on_failure",
          "parameters"
        ],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "check_type": { "type": "string", "minLength": 1 },
          "check_version": { "type": "string", "minLength": 1 },
          "requirement_id": { "type": "string", "minLength": 1 },
          "executor": { "type": "string", "minLength": 1 },
          "severity_on_failure": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object" }
        }
      }
    }
  }
}

